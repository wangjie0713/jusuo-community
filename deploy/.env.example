# Copy to deploy/.env locally. Do not commit the copy.
CE_MODE=demo
CE_HOST=127.0.0.1
CE_PORT=4177
# Required for real mode or the optional container template. Replace before use.
CE_PASSWORD=REPLACE_WITH_YOUR_OWN_LONG_PASSWORD
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=REPLACE_WITH_YOUR_OWN_HA_TOKEN
# Only needed when using a trusted HTTPS reverse proxy:
# CE_PUBLIC_ORIGIN=https://localhost:8443
